<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>New Post</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f9f9f9; }
    .container { max-width: 700px; margin: 0 auto; padding: 0 20px 40px; }
    label { display: block; margin-bottom: 4px; font-weight: bold; }
    input, textarea { width: 100%; padding: 9px; margin-bottom: 16px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 14px; }
    button { padding: 10px 24px; background: #333; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; }
    .error { color: red; margin-bottom: 14px; }
    a { color: #333; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container">
    <a href="/">← Back</a>
    <h1>Create New Post</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="POST" action="/posts">
      <label>Title</label>
      <input type="text" name="title" placeholder="Post title" />

      <label>Author</label>
      <input type="text" name="author" placeholder="Your name" />

      <label>Content</label>
      <textarea name="body" rows="7" placeholder="Write your post here..."></textarea>

      <button type="submit">Publish Post</button>
    </form>
  </div>
</body>
</html>
