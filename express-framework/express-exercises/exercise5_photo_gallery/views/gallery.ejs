<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Photo Gallery</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 30px auto; padding: 0 20px; }
    h1 { text-align: center; }
    .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 20px; }
    .card { border: 1px solid #ddd; border-radius: 8px; overflow: hidden; }
    .card img { width: 100%; height: 200px; object-fit: cover; background: #eee; display: block; }
    .card-body { padding: 12px; }
    .card-body h3 { margin: 0 0 6px; }
    .card-body p { margin: 0 0 10px; color: #666; font-size: 14px; }
    .card-body a { color: #333; text-decoration: none; font-weight: bold; }
    .placeholder { width: 100%; height: 200px; background: #ddd; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px; }
  </style>
</head>
<body>
  <h1>Photo Gallery</h1>

  <div class="gallery">
    <% photos.forEach(function(photo) { %>
      <div class="card">
        <div class="placeholder">[ <%= photo.title %> ]</div>
        <div class="card-body">
          <h3><%= photo.title %></h3>
          <p><%= photo.description %></p>
          <a href="/photo/<%= photo.id %>">View Photo</a>
        </div>
      </div>
    <% }); %>
  </div>
</body>
</html>
