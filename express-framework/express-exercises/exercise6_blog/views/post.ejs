<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= post.title %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f9f9f9; }
    .container { max-width: 800px; margin: 0 auto; padding: 0 20px 40px; }
    .post { background: white; border: 1px solid #ddd; border-radius: 6px; padding: 30px; }
    .meta { color: #999; font-size: 13px; margin-bottom: 20px; }
    .body { line-height: 1.7; color: #333; }
    a { color: #333; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="container">
    <a href="/">← Back to all posts</a>
    <br><br>
    <div class="post">
      <h1><%= post.title %></h1>
      <div class="meta">By <%= post.author %> &nbsp;|&nbsp; <%= post.date %></div>
      <div class="body"><%= post.body %></div>
    </div>
  </div>
</body>
</html>
