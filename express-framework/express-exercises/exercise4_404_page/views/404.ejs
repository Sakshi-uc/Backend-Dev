<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>404 - Page Not Found</title>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; margin-top: 100px; background: #f5f5f5; }
    h1 { font-size: 80px; margin: 0; color: #333; }
    h2 { color: #666; }
    p { color: #999; }
    a { color: #333; text-decoration: none; border-bottom: 1px solid #333; }
  </style>
</head>
<body>
  <h1>404</h1>
  <h2>Page Not Found</h2>
  <p>The page <strong><%= url %></strong> does not exist.</p>
  <a href="/">Go back home</a>
</body>
</html>
